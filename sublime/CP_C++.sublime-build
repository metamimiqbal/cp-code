{
    "cmd": ["/opt/homebrew/bin/g++-15", "-std=c++20", "-O3", "-Wall", "$file", "-o", "${file_path}/${file_base_name}"],
    "file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$",
    "working_dir": "$file_path",
    "selector": "source.c++",
    "variants": [
        {
            "name": "Compile & Run",
            "cmd": ["sh", "-c", "/opt/homebrew/bin/g++-15 -std=c++20 -O3 -Wall '$file' -o '${file_path}/${file_base_name}' && /opt/homebrew/bin/gtimeout 3s '${file_path}/${file_base_name}' < inputf.in > outputf.in"]
        }
    ]
}
